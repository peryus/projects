<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Articles</title>
    <link rel="icon" href="/favicon.ico">
</head>
<body>
<h1>Articles</h1>

<ul>
    <% articles.forEach(article => { %>
        <li>
            <a href="/articles/<%= article.id %>">
                <%= article.title %>
            </a>
        </li>
    <% }) %>
</ul>
</body>
</html>